# ==============================================================================
# SWC (Smart Waste Complaint) Platform - Environment Variables Template
# Copy this file to '.env' and fill in your local values. Never commit '.env'.
# ==============================================================================

# --- DJANGO CONFIGURATION ---
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-random-key
ALLOWED_HOSTS=localhost,127.0.0.1

# --- DATABASE CONFIGURATION (PostgreSQL + PostGIS) ---
# For local dev without docker, use discrete variables or a local URL
DATABASE_URL=postgis://postgres:postgres@localhost:5432/swc_db
DB_NAME=swc_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- AI CONFIGURATION (Gemini API) ---
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini  # Supported: gemini | mock

# --- CACHE & TASK INFRASTRUCTURE (Optional for MVP, required for production scaling) ---
REDIS_URL=redis://localhost:6379/0

# --- OBJECT STORAGE (Optional for MVP - defaults to Local FileSystemStorage) ---
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_STORAGE_BUCKET_NAME=your_swc_media_bucket
# AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com
# USE_S3=False
